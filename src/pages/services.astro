---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import { site } from "../data/site";
---

<Layout
  title={`Services & Pricing | ${site.name}`}
  description={`Lash extension, lift, perm, and refill services at ${site.name} in ${site.area}.`}
>
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <h1 class="text-center font-display text-4xl text-ink">Services &amp; Pricing</h1>
    <p class="mt-3 text-center text-sm text-muted">{site.tagline}</p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {site.services.map((service) => (
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h2 class="font-display text-xl text-ink">{service.name}</h2>
          <p class="mt-2 text-sm leading-6 text-muted">{service.description}</p>
          <div class="mt-4 flex items-center justify-between text-sm font-semibold text-ink">
            <span>{service.price}</span>
            <span class="text-muted">{service.duration}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 flex justify-center">
      <BookNowButton />
    </div>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>
