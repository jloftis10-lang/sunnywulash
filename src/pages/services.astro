---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import ExpandableImage from "../components/ExpandableImage.astro";
import classicPhoto from "../assets/gallery/sunny-wu-lash-08.png";
import hybridPhoto from "../assets/gallery/sunny-wu-lash-20.webp";
import volumePhoto from "../assets/gallery/sunny-wu-lash-21.webp";
import megaPhoto from "../assets/gallery/sunny-wu-lash-24.webp";
import wetPhoto from "../assets/gallery/sunny-wu-lash-11.webp";
import detailPhoto from "../assets/gallery/sunny-wu-lash-23.webp";
import { site } from "../data/site";

const lashExtensions = site.services.filter((service) => service.refill);
const addOns = site.services.filter((service) => !service.refill);
// Portfolio inspiration, rather than claims about the technique in each photo.
const servicePhotos = [
  { src: classicPhoto, alt: "Profile view of a client with curled lash extensions by Sunny" },
  { src: hybridPhoto, alt: "Blonde client showing Sunny's finished lash work in natural light" },
  { src: volumePhoto, alt: "Client portrait showing a full, textured lash look by Sunny" },
  { src: megaPhoto, alt: "Close-up of a dense, curled lash set by Sunny" },
  { src: wetPhoto, alt: "Detail of separated, defined lash extensions by Sunny" },
];
---

<Layout
  title={`Services & Pricing | ${site.name}`}
  description={`Lash extension, lift, tint, and brow services at ${site.name} in ${site.area}.`}
>
  <Header />

  <main class="page-shell mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <section class="holiday-special" aria-labelledby="holiday-special-title">
      <div class="holiday-special__sparkle" aria-hidden="true">✨</div>
      <div class="holiday-special__content">
        <p class="holiday-special__eyebrow">{site.promotion.eyebrow}</p>
        <h1 id="holiday-special-title">{site.promotion.title}</h1>
        <div class="holiday-special__offers" aria-label="Holiday lash offers">
          <p><strong>{site.promotion.fillOffer}</strong></p>
          <p><strong>{site.promotion.setOffer}</strong></p>
        </div>
        <div class="holiday-special__prices">
          {site.promotion.fullSetPrices.map((price) => (
            <div>
              <span>{price.name}</span>
              <span class="holiday-special__regular">{price.regular}</span>
              <strong>{price.special}</strong>
            </div>
          ))}
        </div>
        <p class="holiday-special__dates">
          Offer valid <strong>{site.promotion.validThrough}</strong>
        </p>
        <BookNowButton label="Book Your Holiday Lashes" />
      </div>
      <div class="holiday-special__badge" aria-hidden="true">$20<br /><span>OFF</span></div>
    </section>

    <h1 class="text-center font-display text-4xl text-ink">Services &amp; Pricing</h1>
    <p class="mt-3 text-center text-sm text-muted">{site.tagline}</p>

    <h2 class="mt-14 font-display text-2xl text-ink">Lash Extensions</h2>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">A little definition or a little drama? Find your starting point below. Photos are inspiration from Sunny's portfolio; your lash style is customized to your eyes and natural lashes.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {lashExtensions.map((service, index) => (
        <article class="service-card service-card--photo">
          <div class="service-photo">
            <ExpandableImage
              src={servicePhotos[index].src}
              alt={servicePhotos[index].alt}
              width={700}
              height={700}
              sizes="(min-width: 640px) 50vw, 100vw"
              loading="lazy"
              class="h-full w-full object-cover object-top"
            />
          </div>
          <div class="p-6 sm:p-8">
          <p class="service-photo-credit">Sunny's portfolio &middot; Look inspiration</p>
          <h3 class="font-display text-xl text-ink">{service.name}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{service.description}</p>
          <div class="mt-4 flex items-center justify-between text-sm font-semibold text-ink">
            <span>Full Set - {service.price}</span>
            <span class="text-muted">{service.duration}</span>
          </div>
          {service.refill && (
            <div class="mt-4 grid grid-cols-3 gap-2 border-t border-line pt-4 text-center text-xs">
              <div>
                <p class="font-semibold text-ink">{service.refill.twoWeek}</p>
                <p class="mt-1 text-muted">Refill · 2 wks</p>
              </div>
              <div>
                <p class="font-semibold text-ink">{service.refill.threeWeek}</p>
                <p class="mt-1 text-muted">Refill · 3 wks</p>
              </div>
              <div>
                <p class="font-semibold text-ink">{service.refill.touchUp}</p>
                <p class="mt-1 text-muted">Touch-Up</p>
              </div>
            </div>
          )}
          </div>
        </article>
      ))}
    </div>

    <h2 class="mt-14 font-display text-2xl text-ink">Lash &amp; Brow Add-Ons</h2>
    <div class="service-details mt-6">
      <div class="service-details__photo">
        <ExpandableImage
          src={detailPhoto}
          alt="Finished lash extensions with purple accents from Sunny's client portfolio"
          width={500}
          height={400}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="service-details__copy">
        <p class="service-photo-credit">The finishing touches</p>
        <h3 class="font-display text-2xl text-ink">It's all in the details.</h3>
        <p class="mt-3 text-sm leading-6 text-muted">Explore natural lash lifts, tinting, brow shaping, and more below. Text Sunny to talk through the right combination for your look.</p>
        <a href="/gallery" class="mt-4 inline-block text-sm font-semibold text-primary">See more of Sunny's work &rarr;</a>
      </div>
    </div>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {addOns.map((service) => (
        <div class="service-card p-6 sm:p-8">
          <h3 class="font-display text-xl text-ink">{service.name}</h3>
          <p class="mt-2 text-sm leading-6 text-muted">{service.description}</p>
          <div class="mt-4 flex items-center justify-between text-sm font-semibold text-ink">
            <span>{service.price}</span>
            <span class="text-muted">{service.duration}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-14 flex justify-center">
      <BookNowButton />
    </div>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>

<style>
  .service-card--photo { overflow: hidden; }
  .service-photo { aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-lavender); }
  .service-photo-credit { margin-bottom: .65rem; color: var(--color-primary); font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .service-details { display: grid; overflow: hidden; border: 2px solid var(--color-line); border-radius: 2rem .75rem 2rem .75rem; background: var(--color-surface); }
  .service-details__photo { aspect-ratio: 5 / 4; overflow: hidden; }
  .service-details__copy { align-self: center; padding: 1.75rem; }
  @media (min-width: 640px) {
    .service-card--photo:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
    .service-card--photo:last-child .service-photo { height: 100%; min-height: 20rem; aspect-ratio: auto; }
    .service-details { grid-template-columns: 1fr 1.2fr; }
    .service-details__copy { padding: 2rem; }
  }
</style>

