---
import ExpandableImage from "../components/ExpandableImage.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import SocialSpecialsTeaser from "../components/SocialSpecialsTeaser.astro";
import { site } from "../data/site";
import aboutPhoto from "../assets/about-sunny.png";
import lashDownward from "../assets/training/lash-direction-downward.png";
import lashUpward from "../assets/training/lash-direction-upward.png";
import lashStraight from "../assets/training/lash-direction-straight.png";

const lashDirectionDiagrams = [
  { src: lashDownward, label: "Downward", alt: "Training diagram showing downward lash-direction mapping with numbered angle references" },
  { src: lashUpward, label: "Upward", alt: "Training diagram showing upward lash-direction mapping with numbered angle references" },
  { src: lashStraight, label: "Straight", alt: "Training diagram showing straight lash-direction mapping with numbered angle references" },
];
---

<Layout
  title={`About ${site.about.ownerName} | ${site.name}`}
  description={`Meet ${site.about.ownerName}, the lash artist behind ${site.name} in ${site.area}.`}
>
  <Header />

  <main class="page-shell mx-auto max-w-4xl px-6 py-16 sm:py-20">
    <SocialSpecialsTeaser />
    <div class="grid items-center gap-10 sm:grid-cols-2">
      <div class="about-portrait aspect-square overflow-hidden bg-surface">
        <ExpandableImage
          src={aboutPhoto}
          alt={`${site.about.ownerName}, owner of ${site.name}`}
          width={500}
          height={500}
          loading="eager"
          class="h-full w-full object-cover"
        />
      </div>
      <div>
        <h1 class="font-display text-4xl text-ink">Meet {site.about.ownerName}</h1>
        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary">{site.tagline}</p>
        <p class="mt-4 text-sm leading-7 text-muted">{site.about.bio}</p>
        <p class="mt-4 text-sm leading-7 text-muted">
          <span class="font-semibold text-ink">Experience: </span>
          {site.about.experience}
        </p>
        <p class="mt-2 text-sm leading-7 text-muted">
          <span class="font-semibold text-ink">Training: </span>
          {site.about.training}
        </p>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="font-display text-2xl text-ink">Lash Direction Reference</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">
        Reference diagrams from Sunny's SmarterU training course on mapping lash direction — not photos of her own client work, just the study material behind her technique.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        {lashDirectionDiagrams.map((diagram) => (
          <figure class="rounded-2xl border border-line bg-surface p-4 text-center">
            <ExpandableImage
              src={diagram.src}
              alt={diagram.alt}
              width={360}
              height={400}
              loading="lazy"
              class="mx-auto h-auto w-full max-w-[220px]"
            />
            <figcaption class="mt-2 text-sm font-semibold text-ink">{diagram.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="mt-14 flex justify-center">
      <BookNowButton />
    </div>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>
