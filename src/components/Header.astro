---
import BrandLogo from "./BrandLogo.astro";
import BookNowButton from "./BookNowButton.astro";

const navLinks = [
  { label: "Services", href: "/services" },
  { label: "Gallery", href: "/gallery" },
  { label: "About", href: "/about" },
  { label: "Policies", href: "/policies" },
];
---

<header class="site-header sticky top-0 z-40">
  <div class="header-inner flex items-center justify-between gap-4">
    <a href="/" class="shrink-0">
      <BrandLogo />
    </a>

    <nav class="hidden items-center gap-2 md:flex" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link text-sm text-ink" aria-current={Astro.url.pathname === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))}
      <BookNowButton />
    </nav>

    <!--
      Native <details>/<summary> disclosure — no JS required, so the mobile
      menu (including Policies and Text to Book) stays reachable with JS off,
      same pattern as the FAQ accordion on /policies. The marker is hidden
      and a custom chevron substituted purely for visual consistency.
    -->
    <details class="mobile-menu md:hidden">
      <summary
        aria-label="Menu"
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center marker:content-none [&::-webkit-details-marker]:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>

      <nav aria-label="Mobile" class="flex flex-col gap-1 border-t border-line px-6 py-4">
        {navLinks.map((link) => (
          <a href={link.href} class="rounded-lg px-2 py-3 text-base font-medium text-ink hover:bg-surface">
            {link.label}
          </a>
        ))}
        <div class="pt-2">
          <BookNowButton class="w-full" />
        </div>
      </nav>
    </details>
  </div>
</header>
