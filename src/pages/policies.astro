---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import { site } from "../data/site";
import gallery05 from "../assets/gallery/sunny-wu-lash-05.png";

// Same share-preview image as Home — see the note there about why this
// is a real gallery photo rather than a logo.
const ogImageResult = await getImage({ src: gallery05, width: 1200, height: 630 });
const ogImage = ogImageResult.src;
---

<Layout
  title={`Policies & Aftercare | ${site.name}`}
  description={`Booking, deposit, cancellation, and aftercare information for ${site.name}.`}
  image={ogImage}
>
  <Header />

  <main class="page-shell policy-page mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <h1 class="text-center font-display text-4xl text-ink">Policies &amp; Aftercare</h1>

    <section class="mt-12">
      <h2 class="font-display text-2xl text-ink">Booking &amp; Deposits</h2>
      <p class="mt-3 text-sm leading-7 text-muted">{site.policies.deposit}</p>
    </section>

    <section class="mt-10">
      <h2 class="font-display text-2xl text-ink">Cancellations{site.policies.lateArrival && " & Late Arrivals"}</h2>
      <p class="mt-3 text-sm leading-7 text-muted">
        <span class="font-semibold text-ink">Cancellations: </span>
        {site.policies.cancellation}
      </p>
      {site.policies.lateArrival && (
        <p class="mt-3 text-sm leading-7 text-muted">
          <span class="font-semibold text-ink">Late arrivals: </span>
          {site.policies.lateArrival}
        </p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="font-display text-2xl text-ink">Fill Timing</h2>
      <p class="mt-3 text-sm leading-7 text-muted">{site.policies.fillTiming}</p>
    </section>

    {site.prep.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-2xl text-ink">How to Prepare</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-muted">
          {site.prep.map((step) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-primary">•</span>
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {site.aftercare.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-2xl text-ink">Aftercare</h2>
        <ul class="mt-3 space-y-2 text-sm leading-7 text-muted">
          {site.aftercare.map((step) => (
            <li class="flex gap-2">
              <span aria-hidden="true" class="text-primary">•</span>
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {site.faqs.length > 0 && (
      <section class="mt-10">
        <h2 class="font-display text-2xl text-ink">Frequently Asked Questions</h2>
        <div class="mt-3 divide-y divide-line">
          {site.faqs.map((faq) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none">
                {faq.q}
              </summary>
              <p class="mt-2 text-sm leading-7 text-muted">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="mt-14 flex justify-center">
      <BookNowButton />
    </div>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>
