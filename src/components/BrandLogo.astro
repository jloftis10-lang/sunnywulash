---
import { Image } from "astro:assets";
import logo from "../assets/sunnywu-logo.png";
import { site } from "../data/site";

interface Props {
  hero?: boolean;
}

const { hero = false } = Astro.props;
const logoWidth = 528;
const logoHeight = Math.round(logoWidth * logo.height / logo.width);
---

<Image
  src={logo}
  alt={site.name}
  width={logoWidth}
  height={logoHeight}
  loading="eager"
  class={hero ? "h-auto w-full max-w-sm rounded-2xl" : "h-auto w-40 sm:w-44"}
/>
