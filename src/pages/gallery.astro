---
import ExpandableImage from "../components/ExpandableImage.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import { site } from "../data/site";

import gallery01 from "../assets/gallery/sunny-wu-lash-01.png";
import gallery02 from "../assets/gallery/sunny-wu-lash-02.png";
import gallery03 from "../assets/gallery/sunny-wu-lash-03.png";
import gallery04 from "../assets/gallery/sunny-wu-lash-04.png";
import gallery07 from "../assets/gallery/sunny-wu-lash-07.png";
import gallery08 from "../assets/gallery/sunny-wu-lash-08.png";
import gallery09 from "../assets/gallery/sunny-wu-lash-09.webp";
import gallery10 from "../assets/gallery/sunny-wu-lash-10.webp";
import gallery11 from "../assets/gallery/sunny-wu-lash-11.webp";
import gallery12 from "../assets/gallery/sunny-wu-lash-12.webp";
import gallery13 from "../assets/gallery/sunny-wu-lash-13.png";
import gallery14 from "../assets/gallery/sunny-wu-lash-14.webp";
import gallery15 from "../assets/gallery/sunny-wu-lash-15.webp";
import gallery16 from "../assets/gallery/sunny-wu-lash-16.webp";
import gallery20 from "../assets/gallery/sunny-wu-lash-20.webp";
import gallery21 from "../assets/gallery/sunny-wu-lash-21.webp";
import gallery22 from "../assets/gallery/sunny-wu-lash-22.webp";
import gallery23 from "../assets/gallery/sunny-wu-lash-23.webp";
import gallery24 from "../assets/gallery/sunny-wu-lash-24.webp";
import gallery25 from "../assets/gallery/sunny-wu-lash-25.webp";
import gallery26 from "../assets/gallery/sunny-wu-lash-26.webp";
import gallery27 from "../assets/gallery/sunny-wu-lash-27.webp";
import gallery28 from "../assets/gallery/sunny-wu-lash-28.webp";

const galleryAssets: Record<string, ImageMetadata> = {
  "sunny-wu-lash-01.png": gallery01,
  "sunny-wu-lash-02.png": gallery02,
  "sunny-wu-lash-03.png": gallery03,
  "sunny-wu-lash-04.png": gallery04,
  "sunny-wu-lash-07.png": gallery07,
  "sunny-wu-lash-08.png": gallery08,
  "sunny-wu-lash-09.webp": gallery09,
  "sunny-wu-lash-10.webp": gallery10,
  "sunny-wu-lash-11.webp": gallery11,
  "sunny-wu-lash-12.webp": gallery12,
  "sunny-wu-lash-13.png": gallery13,
  "sunny-wu-lash-14.webp": gallery14,
  "sunny-wu-lash-15.webp": gallery15,
  "sunny-wu-lash-16.webp": gallery16,
  "sunny-wu-lash-20.webp": gallery20,
  "sunny-wu-lash-21.webp": gallery21,
  "sunny-wu-lash-22.webp": gallery22,
  "sunny-wu-lash-23.webp": gallery23,
  "sunny-wu-lash-24.webp": gallery24,
  "sunny-wu-lash-25.webp": gallery25,
  "sunny-wu-lash-26.webp": gallery26,
  "sunny-wu-lash-27.webp": gallery27,
  "sunny-wu-lash-28.webp": gallery28,
};
---

<Layout
  title={`Gallery | ${site.name}`}
  description={`Real lash extension work by ${site.name} in ${site.area}.`}
>
  <Header />

  <main class="page-shell mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <h1 class="text-center font-display text-4xl text-ink">Gallery</h1>
    <p class="mt-3 text-center text-sm text-muted">Real sets, real clients - no stock photos.</p>

    <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-7">
      {site.gallery.map((item, index) => (
        <div class="photo-card aspect-square">
          <ExpandableImage
            src={galleryAssets[item.src]}
            alt={item.alt}
            width={400}
            height={400}
            loading={index < 3 ? "eager" : "lazy"}
            class="h-full w-full object-cover"
          />
        </div>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href={site.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-primary hover:text-primary-dark"
      >
        Follow on Instagram 
      </a>
    </div>

    <div class="mt-14 flex justify-center">
      <BookNowButton />
    </div>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>

