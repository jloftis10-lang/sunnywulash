---
import { Image } from "astro:assets";
import logo from "../assets/sunnywu-hero-logo.png";
import { site } from "../data/site";

interface Props {
  hero?: boolean;
}

const { hero = false } = Astro.props;
const logoWidth = hero ? 608 : 288;
const logoHeight = Math.round(logoWidth * logo.height / logo.width);
---

<Image
  src={logo}
  alt={site.name}
  width={logoWidth}
  height={logoHeight}
  loading="eager"
  class:list={["brand-logo", { "brand-logo--hero": hero }]}
/>
