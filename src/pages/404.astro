---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookNowButton from "../components/BookNowButton.astro";
import { site } from "../data/site";
---

<Layout title={`Page Not Found | ${site.name}`} description="This page could not be found.">
  <Header />

  <main class="mx-auto max-w-xl px-6 py-24 text-center">
    <h1 class="font-display text-4xl text-ink">Page not found</h1>
    <p class="mt-4 text-sm leading-7 text-muted">
      The page you're looking for doesn't exist. Head back home, or book your next appointment.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-6 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary"
      >
        Back to Home
      </a>
      <BookNowButton />
    </div>
  </main>

  <Footer />
</Layout>
