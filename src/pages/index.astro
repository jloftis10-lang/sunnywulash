---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import BrandLogo from "../components/BrandLogo.astro";
import Footer from "../components/Footer.astro";
import StickyBookBar from "../components/StickyBookBar.astro";
import BookNowButton from "../components/BookNowButton.astro";
import { site } from "../data/site";

import gallery02 from "../assets/gallery/sunny-wu-lash-02.png";
import gallery01 from "../assets/gallery/sunny-wu-lash-01.png";
import gallery05 from "../assets/gallery/sunny-wu-lash-05.png";
import gallery08 from "../assets/gallery/sunny-wu-lash-08.png";
import aboutPhoto from "../assets/about-sunny.png";

// A short, representative preview strip — the full 8-photo set lives on
// /gallery so Home stays a quick highlight reel, not a second copy of it.
const galleryPreview = [
  { src: gallery05, alt: "Finished dramatic volume lash extensions with under-eye gel pads still in place" },
  { src: gallery02, alt: "Close-up comparison of natural lashes before and after a full set of volume lash extensions" },
  { src: gallery08, alt: "Close-up profile view of finished volume lash extensions" },
  { src: gallery01, alt: "Collage of finished lash extensions with numbered lash maps showing different lengths and placement" },
];

const telHref = `tel:+1${site.phone.replace(/\D/g, "")}`;
const smsHref = `sms:+1${site.phone.replace(/\D/g, "")}`;
const fullAddress = site.address
  ? `${site.address.street}, ${site.address.city}, ${site.address.state} ${site.address.zip}`
  : "";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;

// Use the real lash photo from the hero as the share-preview image.
const ogImageResult = await getImage({ src: gallery05, width: 1200, height: 630 });
const ogImage = ogImageResult.src;

const hoursSpecification = {
  "@type": "OpeningHoursSpecification",
  dayOfWeek: site.hours.map((entry) => entry.day),
  opens: "08:00",
  closes: "20:00",
};

const sameAs = [site.social.instagram, site.social.facebook, site.social.yelp].filter(Boolean);

// Add a price range when the client provides confirmed service prices.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  name: site.name,
  url: new URL("/", Astro.site).toString(),
  image: new URL(ogImage, Astro.site).toString(),
  telephone: `+1${site.phone.replace(/\D/g, "")}`,
  ...(site.address
    ? {
        address: {
          "@type": "PostalAddress",
          streetAddress: site.address.street,
          addressLocality: site.address.city,
          addressRegion: site.address.state,
          postalCode: site.address.zip,
          addressCountry: "US",
        },
      }
    : { areaServed: site.serviceArea }),
  openingHoursSpecification: hoursSpecification,
  sameAs,
};
---

<Layout
  title={`${site.name} | Lash Extensions in ${site.area}`}
  description={site.tagline}
  image={ogImage}
  structuredData={structuredData}
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="home-hero px-6 py-10 sm:py-16">
      <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 lg:gap-16">
        <div class="text-left">
          <BrandLogo hero />
          <h1 class="mt-6 font-display text-4xl font-semibold text-ink sm:text-5xl">
            Lash Extensions in {site.area}
          </h1>
          <p class="mt-4 text-lg text-muted">{site.tagline}</p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <BookNowButton />
            <a
              href="/services"
              class="inline-flex min-h-11 items-center justify-center rounded-full border border-primary px-6 py-3 text-sm font-semibold text-primary hover:bg-primary hover:text-white"
            >
              See Services
            </a>
          </div>
          <a href={telHref} class="mt-5 inline-block text-sm font-medium text-primary underline decoration-primary/40 underline-offset-4">
            {site.phone}
          </a>
        </div>
        <div class="overflow-hidden rounded-[2rem] border-4 border-canvas bg-surface shadow-xl shadow-primary/15">
          <Image
            src={gallery05}
            alt="Close-up of a finished set of Sunny's full lash extensions"
            width={560}
            height={560}
            sizes="(min-width: 1152px) 520px, (min-width: 768px) 46vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-square h-auto w-full object-cover"
          />
        </div>
      </div>
    </section>

    <!-- Services teaser -->
    <section class="home-services border-t border-line bg-surface px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl text-ink">What I Offer</h2>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          {site.services.map((service) => (
            <span class="rounded-full border border-line bg-canvas px-4 py-2 text-sm font-medium text-ink">
              {service.name}
            </span>
          ))}
        </div>
        <a
          href="/services"
          class="mt-8 inline-flex text-sm font-semibold text-primary hover:text-primary-dark"
        >
          See Full Services &amp; Pricing →
        </a>
      </div>
    </section>

    <!-- Gallery preview -->
    <section class="home-gallery px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-center font-display text-3xl text-ink">Recent Work</h2>
        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {galleryPreview.map((item, index) => (
            <div class="aspect-square overflow-hidden rounded-xl bg-surface">
              <Image
                src={item.src}
                alt={item.alt}
                width={300}
                height={300}
                loading={index < 2 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/gallery" class="text-sm font-semibold text-primary hover:text-primary-dark">
            View Full Gallery →
          </a>
        </div>
      </div>
    </section>

    <!-- About teaser -->
    <section class="home-about border-t border-line bg-surface px-6 py-16 sm:py-20">
      <div class="mx-auto flex max-w-xl flex-col items-center gap-5 text-center">
        <div class="h-28 w-28 overflow-hidden rounded-full bg-canvas">
          <Image
            src={aboutPhoto}
            alt={`${site.about.ownerName}, owner of ${site.name}`}
            width={200}
            height={200}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <h2 class="font-display text-3xl text-ink">Meet {site.about.ownerName}</h2>
        <p class="text-sm leading-7 text-muted">{site.tagline}</p>
        <a href="/about" class="text-sm font-semibold text-primary hover:text-primary-dark">
          Learn More About {site.about.ownerName} →
        </a>
      </div>
    </section>

    <!-- Reviews (hidden entirely if empty) -->
    {site.reviews.length > 0 && (
      <section class="home-reviews px-6 py-16 sm:py-20">
        <div class="mx-auto max-w-5xl">
          <h2 class="text-center font-display text-3xl text-ink">What Clients Say</h2>
          <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {site.reviews.map((review) => (
              <figure class="rounded-2xl border border-line bg-canvas p-6">
                <blockquote class="text-sm leading-6 text-ink">
                  &ldquo;{review.text}&rdquo;
                </blockquote>
                <figcaption class="mt-4 text-xs font-semibold text-muted">
                  {review.author} · {review.source}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Visit -->
    <section class="home-visit border-t border-line bg-surface px-6 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl text-ink">Visit the Studio</h2>

        {site.address && (
          <p class="mt-4 text-sm leading-7 text-muted">
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </p>
        )}
        {!site.address && site.serviceArea && (
          <p class="mt-4 text-sm leading-7 text-muted">{site.serviceArea}</p>
        )}

        <ul class="mt-6 space-y-1 text-sm text-muted">
          {site.hours.map((entry) => (
            <li>
              <span class="font-medium text-ink">{entry.day}:</span> {entry.open} – {entry.close}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={telHref} class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary">
            Call {site.phone}
          </a>
          <a href={smsHref} class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary">
            Text {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary">
            Email
          </a>
          <a href={mapsHref} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-full border border-line px-5 py-3 text-sm font-semibold text-ink hover:border-primary hover:text-primary">
            Get Directions
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <StickyBookBar />
</Layout>
