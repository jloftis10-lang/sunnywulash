---
interface Props { variant?: number; }
const { variant = 0 } = Astro.props;
const counts = [7, 9, 11, 13, 7];
const count = counts[variant % counts.length];
const lashes = Array.from({ length: count }, (_, i) => {
  const t = (i + 0.5) / count;
  const x = 12 + 72 * t;
  const y = 32 + 64 * t * (1 - t);
  const length = 12 + Math.sin(Math.PI * t) * 10;
  const spread = (t - 0.5) * 19;
  return { x, y, length, spread };
});
---

<span class="lash-icon" aria-hidden="true">
  <svg viewBox="0 0 96 80" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <g class="lash-icon__fan">
      <path d="M12 32 Q48 64 84 32" stroke-width="2.8" />
      {lashes.map(({ x, y, length, spread }) => (
        <>
          <path d={`M${x} ${y} Q${x + spread * 0.8} ${y - length * 0.35} ${x + spread} ${y - length}`} stroke-width={variant === 4 ? 2.8 : 2} />
          {variant > 0 && variant < 4 && (
            <path d={`M${x} ${y} Q${x + spread - 4} ${y - length * 0.5} ${x + spread - 3} ${y - length + 2}`} stroke-width="1.3" />
          )}
          {variant === 3 && (
            <path d={`M${x} ${y} Q${x + spread + 4} ${y - length * 0.5} ${x + spread + 3} ${y - length + 1}`} stroke-width="1.1" />
          )}
        </>
      ))}
    </g>
    <path class="lash-icon__sparkle" d="M78 9v10 M73 14h10" stroke-width="1.7" />
  </svg>
</span>

<style>
  .lash-icon { display: inline-grid; place-items: center; flex-shrink: 0; width: 4.5rem; height: 4.5rem; margin-bottom: 1rem; border: 1px solid #80519320; border-radius: 1.25rem; background: #ffffffa8; color: var(--color-primary); transition: transform 220ms ease, background-color 220ms ease; }
  svg { width: 3.75rem; height: 3.25rem; overflow: visible; }
  .lash-icon__fan { transform-box: view-box; transform-origin: 48px 48px; }
  .lash-icon__sparkle { transform-box: fill-box; transform-origin: center; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.service-card:hover) .lash-icon, :global(.service-details:hover) .lash-icon { transform: translateY(-3px) rotate(-4deg); background: white; }
    :global(.service-card:hover) .lash-icon__fan, :global(.service-details:hover) .lash-icon__fan { animation: lash-flutter 800ms ease-in-out; }
    :global(.service-card:hover) .lash-icon__sparkle, :global(.service-details:hover) .lash-icon__sparkle { animation: lash-sparkle 800ms ease-in-out; }
  }
  @keyframes lash-flutter { 0%, 100% { transform: scaleY(1); } 30% { transform: scaleY(.7) rotate(-3deg); } 65% { transform: scaleY(1.08) rotate(2deg); } }
  @keyframes lash-sparkle { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.35) rotate(90deg); opacity: .55; } }
  @media (prefers-reduced-motion: reduce) { .lash-icon { transition: none; } }
</style>
