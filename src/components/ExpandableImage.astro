---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  loading?: "eager" | "lazy";
  sizes?: string;
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const { src, alt, ...thumbnail } = Astro.props;
const expanded = await getImage({ src, width: Math.min(src.width, 1600), format: "webp", quality: 90 });
---

<a href={expanded.src} class="expandable-image" data-expand-image data-caption={alt} aria-label={`Enlarge photo: ${alt}`}>
  <Image src={src} alt={alt} {...thumbnail} />
  <span class="expandable-image__hint" aria-hidden="true">&#x2922;</span>
</a>

<style>
  .expandable-image { position: relative; display: block; width: 100%; height: 100%; cursor: zoom-in; }
  .expandable-image:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -4px; }
  .expandable-image__hint { position: absolute; right: .6rem; bottom: .6rem; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: #25182bba; color: white; font-size: 1.5rem; line-height: 1; pointer-events: none; }
</style>
